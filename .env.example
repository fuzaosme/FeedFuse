DATABASE_URL=postgresql://feedfuse:feedfuse@127.0.0.1:5432/feedfuse
AUTH_INITIAL_PASSWORD=change-me-before-first-login
AUTH_COOKIE_SECURE=false
# 仅在 Web 只接受可信代理请求、且代理覆盖 X-Real-IP 时设为 true。
AUTH_TRUST_PROXY=false
IMAGE_PROXY_SECRET=change-me-before-prod
RSS_NETWORK_MODE=public
# 仅 custom 模式使用；本机 RSS 需显式配置 127.0.0.1/32,::1/128，例外对所有账号生效。
RSS_ALLOWED_CIDRS=
# 构建 web / worker 镜像时使用的 npm 源，仅在从源码 `docker compose up --build` 时生效。
# 无法直连 registry.npmjs.org 的网络（如部分国内环境）改为 https://registry.npmmirror.com。
NPM_REGISTRY=https://registry.npmjs.org
